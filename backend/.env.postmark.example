# Copy to .env.postmark on the server (not deployed by rsync).
# This file is loaded after .env and is safe to keep only on production.
POSTMARK_SERVER_API_TOKEN=your-postmark-server-token
POSTMARK_FROM_EMAIL=no-reply@shorex.green
POSTMARK_MESSAGE_STREAM=outbound
POSTMARK_SAME_DOMAIN_TEST=false
